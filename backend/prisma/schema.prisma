generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------
// ENUMS
// -----------------------------------------------------

enum Role {
  USER // Regular user using the app
  BUSINESS // Garage/Mechanic, Dealership, etc.
  ADMIN // Platform administrator
}

enum EntityType {
  INDIVIDUAL
  SOLE_PROPRIETOR
  LLC
  CORPORATION
}

enum SubscriptionTier {
  FREE
  PREMIUM
  ENTERPRISE
}

enum ReportStatus {
  DRAFT
  PUBLISHED
  DISPUTED
  RESOLVED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  REJECTED
  ACCEPTED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// -----------------------------------------------------
// CORE MODELS
// -----------------------------------------------------

model User {
  id                 String             @id @default(uuid())
  fullName           String?
  email              String             @unique
  phone              String?            @unique
  password           String
  role               Role               @default(USER)
  isActive           Boolean            @default(true)
  verificationStatus VerificationStatus @default(PENDING)
  refreshToken       String?
  lastLoginAt        DateTime?
  avatarUrl          String?

  // Relations
  businessProfile BusinessProfile?
  reportsCreated  Report[]         @relation("ReportAuthor")
  disputesFiled   Dispute[]        @relation("DisputeFiler")
  subscriptions   Subscription[]
  notifications   Notification[]
  auditLogs       AuditLog[]       @relation("AuditUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName   String
  entityType     EntityType
  registrationNo String? // CIN, GST, etc. depending on country
  taxId          String?

  // Address
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zipCode      String
  country      String

  // Verification
  isVerified       Boolean  @default(false)
  verificationDocs String[] // URLs to uploaded docs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------
// REPORTING & BLACKLISTING
// -----------------------------------------------------

model Report {
  id String @id @default(uuid())

  // Author who created the report
  authorId String
  author   User   @relation("ReportAuthor", fields: [authorId], references: [id])

  // Offender details (The "Bad Customer" or "Bad Business")
  offenderName    String
  offenderPhone   String?
  offenderEmail   String?
  offenderDetails String // Description of why they are reported

  // The Incident
  incidentDate DateTime
  amountOwed   Float? // If it's a financial dispute
  evidenceUrls String[] // Photos, invoices, chats

  status      ReportStatus @default(PUBLISHED)
  isAnonymous Boolean      @default(false)

  // Relations
  disputes  Dispute[]
  auditLogs AuditLog[] @relation("AuditReport")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for quick searching
  @@index([offenderPhone])
  @@index([offenderEmail])
  @@index([offenderName])
}

model Dispute {
  id String @id @default(uuid())

  // The report being disputed
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // The person filing the dispute (usually the offender who claimed their profile)
  filerId String
  filer   User   @relation("DisputeFiler", fields: [filerId], references: [id])

  reason         String
  evidenceUrls   String[]
  status         DisputeStatus @default(OPEN)
  resolutionNote String? // Admin's note after resolving

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------
// MONETIZATION & SUBSCRIPTION
// -----------------------------------------------------

model Subscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier      SubscriptionTier @default(FREE)
  startDate DateTime         @default(now())
  endDate   DateTime?

  stripeCustId String?
  stripeSubId  String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------
// SYSTEM & AUDIT
// -----------------------------------------------------

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title  String
  body   String
  isRead Boolean @default(false)
  data   Json? // Any extra payload (like route to navigate to)

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  action  String // e.g., "REPORT_CREATED", "DISPUTE_RESOLVED"
  details String

  reportId String?
  report   Report? @relation("AuditReport", fields: [reportId], references: [id], onDelete: SetNull)

  ipAddress String?
  createdAt DateTime @default(now())
}
